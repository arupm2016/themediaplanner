# Browser-safe Supabase settings only. The publishable key is designed for public clients;
# access is restricted by RLS. Never expose a secret/service_role key as VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Edge Function secrets (set with: supabase secrets set NAME=value)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=https://your-production-domain.example

# Razorpay server-only secrets. Never commit these values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: Razorpay recurring Subscriptions API requires pre-created Razorpay plan IDs
# and an approved/activated Subscriptions product on the merchant account.
RAZORPAY_PLAN_SOLO_MONTHLY=
RAZORPAY_PLAN_AGENCY_MONTHLY=
RAZORPAY_PLAN_ENTERPRISE_MONTHLY=
