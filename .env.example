# Optional integrations. The MVP runs without these values.
# Supabase (auth + cloud persistence) — never expose service_role keys in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Sheets OAuth should be implemented through a secure backend / OAuth flow.
# Never commit Google client secrets or refresh tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
